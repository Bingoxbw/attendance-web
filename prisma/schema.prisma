generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id           String   @id @default(cuid())
  name         String
  yikatong     String?
  studentId    String?
  gender       String?
  phone        String?
  partyStatus  String?
  advisor      String?
  remark       String?
  roleTag      String?
  branchName   String   @default("通信研究生第九党支部")
  isActivist   Boolean  @default(false)
  needsFix     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendanceRecords AttendanceRecord[]

  @@index([studentId])
  @@index([yikatong])
  @@index([name])
  @@index([branchName])
}

model Activity {
  id           String    @id @default(cuid())
  title        String
  checkInCode  String?
  createdAtSrc String?
  startAt      DateTime?
  endAt        DateTime?
  address      String?
  sourceFile   String?
  sourceApp    String?
  importedAt   DateTime  @default(now())

  records AttendanceRecord[]
}

model AttendanceRecord {
  id              String    @id @default(cuid())
  activityId      String
  rawName         String
  rawStudentId    String?
  rawBranchName   String?
  signedAt        DateTime?
  isNewPartyMember Boolean?
  memberId        String?
  matchMethod     String    @default("unmatched")
  // xuehao | yikatong | name | manual | unmatched | ambiguous

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  member   Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([activityId])
  @@index([memberId])
}

model SecretaryAccount {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String
  branchName   String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([branchName])
}

model TutorialDocument {
  id           String   @id @default(cuid())
  title        String
  category     String
  relativePath String   @unique
  ext          String
  size         Int      @default(0)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([category])
}

model QaThread {
  id                String   @id @default(cuid())
  title             String
  body              String
  authorRole        String
  authorName        String
  authorSecretaryId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  replies QaReply[]
}

model QaReply {
  id                String   @id @default(cuid())
  threadId          String
  body              String
  authorRole        String
  authorName        String
  authorSecretaryId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  thread QaThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}
